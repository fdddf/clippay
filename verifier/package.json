{
  "name": "verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "once": "tsx --env-file=.env src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "e2e:passkey": "tsx --env-file=.env scripts/e2e-passkey.ts",
    "e2e:anchor": "tsx --env-file=.env scripts/e2e-anchor.ts",
    "test": "tsx --test test/*.test.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "dev:worker": "pnpm --filter web build && wrangler dev",
    "seed:metadata": "tsx --env-file-if-exists=.env scripts/seed-metadata.ts",
    "e2e:signin": "tsx --env-file-if-exists=.env scripts/e2e-signin.ts"
  },
  "dependencies": {
    "@clippay/anchor": "workspace:*",
    "@clippay/deployments": "workspace:*",
    "@clippay/pool-client": "workspace:*",
    "@expo-google-fonts/inter": "0.4.2",
    "@resvg/resvg-wasm": "2.6.2",
    "@stellar/stellar-sdk": "~16.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@types/node": "^24.0.0",
    "smart-account-kit": "0.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4"
  }
}
