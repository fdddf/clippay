# Contract IDs, RPC and network come from deployments/$NETWORK.json. Any of
# RPC_URL, NETWORK_PASSPHRASE, CONTRACT_ID, TOKEN_ID, ACCOUNT_WASM_HASH,
# SMART_ACCOUNT_DEPLOYER set here overrides it.
NETWORK=testnet
# secret key of the address passed as `verifier` to the contract constructor
VERIFIER_SECRET=
# youtube | mock — mock grows views over time so you can demo without an API key
VIEW_PROVIDER=mock
MOCK_VIEWS_PER_SECOND=10
YOUTUBE_API_KEY=
# Checks before a post is paid (YouTube only; see src/checks.ts). Fixable
# problems (tag, #ad) hold the post until fixed; anti-fraud flags hold it until
# a reviewer approves it with POST /review/:id/:creator.
REQUIRE_OWNERSHIP_TAG=true
REQUIRE_AD_DISCLOSURE=true
MAX_VIEWS_PER_HOUR=500000
MIN_LIKE_RATIO=0.002
MIN_VIEWS_FOR_ENGAGEMENT=5000
MIN_CHANNEL_AGE_DAYS=7
# hold posts published before the campaign started
REQUIRE_NEW_POST=true
REVIEW_TOKEN=
POLL_SECONDS=60
PORT=8787
# POST /settle/:id per IP per minute
SETTLE_PER_IP_PER_MINUTE=6
TOKEN_ID=

# --- fee sponsoring for passkey wallets (POST /relay) ---
# funded account that pays fees for passkey wallets
SPONSOR_SECRET=
SPONSOR_MAX_FEE_XLM=250
# warn (and call ALERT_WEBHOOK_URL) when the sponsor drops below this
SPONSOR_MIN_XLM=200
ALERT_WEBHOOK_URL=
# sponsored transactions per minute, per IP and per wallet
RELAY_PER_IP_PER_MINUTE=20
RELAY_PER_WALLET_PER_MINUTE=6
# Set to forward sponsored txs to OpenZeppelin Channels instead (key from https://channels.openzeppelin.com/testnet/gen)
OZ_CHANNELS_URL=https://channels.openzeppelin.com/testnet
OZ_CHANNELS_API_KEY=
