{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "verifier",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "verifier",
        "start"
      ],
      "port": 8787
    },
    {
      "name": "verifier-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "verifier",
        "start"
      ],
      "port": 8788,
      "env": {
        "PORT": "8788"
      }
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "VITE_VERIFIER_URL": "http://localhost:8788"
      }
    },
    {
      "name": "web-live-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "env": {
        "API_PROXY": "https://clippay.umesok.workers.dev"
      }
    }
  ]
}